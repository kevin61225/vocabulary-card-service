# Example environment variables for local development
# Copy this file to .env and update values as needed

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# Database Connection
# For SQL Server
ConnectionStrings__DefaultConnection=Server=localhost;Database=VocabularyCardService;User Id=sa;Password=YourStrong@Passw0rd;TrustServerCertificate=True;

# For PostgreSQL (if using)
# ConnectionStrings__DefaultConnection=Host=localhost;Database=VocabularyCardService;Username=postgres;Password=yourpassword

# JWT Settings
JwtSettings__Secret=your-secret-key-must-be-at-least-32-characters-long-change-this
JwtSettings__Issuer=VocabularyCardService
JwtSettings__Audience=VocabularyCardServiceUsers
JwtSettings__ExpirationMinutes=60
JwtSettings__RefreshTokenExpirationDays=30

# CORS Settings
CorsSettings__AllowedOrigins=http://localhost:3000,http://localhost:4200

# Email Settings (for sending verification emails)
EmailSettings__SmtpServer=smtp.gmail.com
EmailSettings__SmtpPort=587
EmailSettings__SenderEmail=noreply@vocabularycard.com
EmailSettings__SenderName=Vocabulary Card Service
EmailSettings__Username=your-email@gmail.com
EmailSettings__Password=your-app-specific-password

# Redis Cache (optional)
# Redis__ConnectionString=localhost:6379

# Application Settings
AppSettings__MaxCardsPerUser=10000
AppSettings__MaxTagsPerCard=10
AppSettings__EnableEmailVerification=true
AppSettings__FrontendUrl=http://localhost:3000

# Logging
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft=Warning
Logging__LogLevel__Microsoft.AspNetCore=Warning

# Rate Limiting
RateLimiting__PerMinute=100
RateLimiting__PerHour=1000

# Feature Flags
Features__EnableUserRegistration=true
Features__EnablePasswordReset=true
Features__EnableEmailVerification=true
